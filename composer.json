{
    "name": "sliva-name/bitrix24-laravel",
    "description": "Laravel integration package for Bitrix24 CRM with OAuth and Webhook support",
    "keywords": [
        "laravel",
        "bitrix24",
        "crm",
        "oauth",
        "webhook",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sliva-name",
            "email": "antyuhov2@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0",
        "bitrix24/b24phpsdk": "^1.10",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Leko\\Bitrix24\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leko\\Bitrix24\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Leko\\Bitrix24\\Providers\\Bitrix24ServiceProvider"
            ],
            "aliases": {
                "Bitrix24": "Leko\\Bitrix24\\Facades\\Bitrix24"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
